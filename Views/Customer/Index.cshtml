@model CrustyCrab.Models.AccountViewModel
@{
    ViewData["Title"] = "My Account";
}

<div class="portal-wrap">
    <div class="kds-head" style="margin-bottom:0">
        <div>
            <span class="eyebrow">Customer Account</span>
            <h1>Hello, @Model.Customer.FirstName</h1>
        </div>
        <span class="location-chip mono">Customer #@Model.Customer.CustomerID</span>
    </div>
    @if (TempData["Error"] is string error)
    {
        <div class="api-error" style="margin-top:24px">@error</div>
    }
    @if (TempData["Success"] is string success)
    {
        <div class="success-note" style="margin-top:24px">@success</div>
    }
    <div class="portal-grid" style="margin-top:24px;">
        <div class="portal-card">
            <h3>Profile</h3>
            <form asp-action="UpdateProfile" method="post">
                <div class="field-row">
                    <div class="field"><label>First Name</label><input name="FirstName" value="@Model.Customer.FirstName" required /></div>
                    <div class="field"><label>Last Name</label><input name="LastName" value="@Model.Customer.LastName" required /></div>
                </div>
                <div class="field"><label>Email</label><input name="EmailAddress" type="email" value="@Model.Customer.EmailAddress" required /></div>
                <div class="field"><label>Phone</label><input name="PhoneNumber" value="@Model.Customer.PhoneNumber" required /></div>
                <button class="btn-blue" type="submit">Save Profile</button>
            </form>
        </div>
        <div class="portal-card">
            <h3>Delivery Addresses</h3>
            @foreach (var address in Model.Addresses)
            {
                <div class="portal-card" style="margin-top:12px;">
                    <form asp-controller="DeliveryAddress" asp-action="UpdateForm" method="post">
                        <input type="hidden" name="id" value="@address.DeliveryAddressID" />
                        <div class="field-row"><div class="field"><label>House Number</label><input name="HouseNumber" value="@address.HouseNumber" required /></div><div class="field"><label>Street Name</label><input name="StreetName" value="@address.StreetName" required /></div></div>
                        <div class="field-row"><div class="field"><label>Suburb</label><input name="Suburb" value="@address.Suburb" required /></div><div class="field"><label>Building Type</label><input name="BuildingType" value="@address.BuildingType" /></div></div>
                        <button class="btn-blue" type="submit">Save Address</button>
                    </form>
                    <form asp-controller="DeliveryAddress" asp-action="DeleteForm" method="post" style="margin-top:10px;"><input type="hidden" name="id" value="@address.DeliveryAddressID" /><button class="stock-btn out" type="submit">Remove Address</button></form>
                </div>
            }
            <form asp-controller="DeliveryAddress" asp-action="CreateForm" method="post" style="margin-top:16px;">
                <div class="field-row">
                    <div class="field"><label>House Number</label><input name="HouseNumber" required /></div>
                    <div class="field"><label>Street Name</label><input name="StreetName" required /></div>
                </div>
                <div class="field"><label>Suburb</label><input name="Suburb" required /></div>
                <div class="field"><label>Building Type</label><input name="BuildingType" placeholder="House, Apartment, Office" /></div>
                <button class="btn-blue" type="submit">Add Address</button>
            </form>
        </div>
    </div>
    <div class="portal-grid" style="margin-top:24px;">
        <div class="portal-card">
            <h3>Saved Payment Methods</h3>
            @foreach (var method in Model.SavedPaymentMethods)
            {
                <div class="stock-row">
                    <div><strong>@method.MethodName</strong><small>@method.CardholderName · **** @method.CardLast4 · @method.ExpiryMonth/@method.ExpiryYear</small></div>
                    <form asp-controller="Payment" asp-action="DeleteCustomerMethodForm" method="post"><input type="hidden" name="id" value="@method.CustomerPaymentMethodID" /><button class="stock-btn out" type="submit">Remove</button></form>
                </div>
            }
            <form asp-controller="Payment" asp-action="SaveCustomerMethodForm" method="post" style="margin-top:16px;">
                <div class="field"><label>Payment Method</label><select name="PaymentMethodID" required><option value="">Select</option>@foreach (var method in Model.PaymentMethods){<option value="@method.PaymentMethodID">@method.MethodName</option>}</select></div>
                <div class="field"><label>Cardholder Name</label><input name="CardholderName" required /></div>
                <div class="field"><label>Card Number</label><input name="CardNumber" inputmode="numeric" minlength="13" maxlength="16" required /></div>
                <div class="field-row">
                    <div class="field"><label>Expiry Month</label><input name="ExpiryMonth" type="number" min="1" max="12" required /></div>
                    <div class="field"><label>Expiry Year</label><input name="ExpiryYear" type="number" min="2026" max="2100" required /></div>
                </div>
                <button class="btn-blue" type="submit">Save Payment Method</button>
            </form>
        </div>
        <div class="portal-card">
            <h3>Order History</h3>
            @foreach (var order in Model.Orders.OrderByDescending(o => o.OrderDate))
            {
                <div class="stock-row">
                    <div><strong>Order #@order.OrderID</strong><small>@order.OrderDate.ToLocalTime().ToString("dd MMM yyyy HH:mm") · @order.DeliveryMethod</small></div>
                    <div style="text-align:right"><strong>R @order.TotalAmount.ToString("N2")</strong><small>@order.OrderStatus</small></div>
                </div>
                @if (!string.Equals(order.OrderStatus, "Cancelled", StringComparison.OrdinalIgnoreCase) && !string.Equals(order.OrderStatus, "Completed", StringComparison.OrdinalIgnoreCase))
                {
                    <form asp-controller="Order" asp-action="CancelForm" method="post" style="margin-bottom:10px;"><input type="hidden" name="id" value="@order.OrderID" /><input type="hidden" name="customerId" value="@Model.Customer.CustomerID" /><button class="stock-btn out" type="submit">Cancel Order</button></form>
                }
            }
            @if (!Model.Orders.Any())
            {
                <p class="muted">No orders yet.</p>
            }
        </div>
    </div>
    <div class="portal-card" style="margin-top:24px;">
        <h3>Account Management</h3>
       <form asp-action="DeleteAccount"
      method="post"
      onsubmit="return confirm('Are you sure you want to delete your account? This action cannot be undone.');">

    <button class="stock-btn out" type="submit">
        Delete Account
    </button>

</form>
    </div>
</div>
