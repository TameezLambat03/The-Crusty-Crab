@{
    ViewData["Title"] = "Customer Feedback";
}

<div class="narrow stack-top">

    <div class="card-panel review-card">

        <span class="eyebrow">
            Customer Review Suite
        </span>

        <h2>
            How was your seafood boil?
        </h2>

        <div class="stars">
            &#9733;&#9733;&#9733;&#9733;&#9733;
        </div>

        <div class="field">

            <textarea placeholder="Tell us about the Cajun garlic butter spice, portion sizes, or delivery speed..."></textarea>

        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn-blue btn-block">
            Submit Review &amp; Return Home
        </a>

    </div>

</div>