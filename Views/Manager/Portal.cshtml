@model CrustyCrab.Models.ManagerPortalViewModel
@{
    ViewData["Title"] = "Manager Portal";
}
<div class="topbar">
    <div class="topbar-inner wide">
        <a asp-controller="Kitchen" asp-action="Kds" class="back-link">&larr; Back</a>
        <span class="topbar-title">UR-03 / US-08 / US-09 Manager Portal</span>
        <span class="top-cta-wrap"><a asp-controller="AdminStaff" asp-action="Index" class="btn-blue">Staff &amp; Admin</a></span>
    </div>
</div>
<div class="portal-wrap">
    <div class="kds-head" style="margin-bottom:0">
        <div>
            <span class="eyebrow">Restaurant Administration</span>
            <h1>Manager Analytics &amp; Inventory Portal</h1>
        </div>
        <span class="location-chip mono">Location: Montgomery Park</span>
    </div>
    @if (ViewData["ApiError"] is string portalError)
    {
        <div class="api-error" style="margin-top:24px">@portalError</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="api-error" style="margin-top:18px">@error</div>
    }
    @if (TempData["Success"] is string success)
    {
        <div class="success-note" style="margin-top:18px">@success</div>
    }
    <div class="portal-grid">
        <div class="portal-card">
            <h3>Stock Toggling (US-08)</h3>
            @foreach (var item in Model.InventoryItems)
            {
                <div class="stock-row">
                    <div><strong>@item.Name</strong><small>Active on customer menu catalog</small></div>
                    <form asp-action="ToggleStock" method="post">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="stock-btn @(item.Status == "In Stock" ? "" : "out")">@item.Status<br />(Toggle)</button>
                    </form>
                </div>
            }
        </div>
        <div class="portal-card">
            <h3>Sales Analytics &amp; Peak Hours (US-09)</h3>
            <div class="stat-row">
                <div class="stat rev"><small>Today's Revenue</small><strong>R @Model.TodaysRevenue.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</strong></div>
                <div class="stat"><small>Peak Order Time</small><strong>@Model.PeakOrderTime</strong></div>
            </div>
            <div class="staff-box">
                <h5>Staff Shift Planning Recommendation</h5>
                <p>@Model.StaffRecommendation</p>
            </div>
        </div>
    </div>
    <div class="portal-card" style="margin-top:24px;">
        <h3>Menu Management</h3>
        <form asp-controller="Menu" asp-action="CreateForm" method="post">
            <div class="field-row">
                <div class="field"><label>Item Name</label><input name="ItemName" required /></div>
                <div class="field"><label>Category</label><input name="Category" required /></div>
            </div>
            <div class="field-row">
                <div class="field"><label>Price</label><input name="Price" type="number" step="0.01" min="0" required /></div>
                <div class="field"><label>Image URL</label><input name="ImageUrl" /></div>
            </div>
            <div class="field"><label>Description</label><textarea name="Description"></textarea></div>
            <label class="addon" style="margin-bottom:14px;"><span><strong>Available</strong><small>Show the item as in stock.</small></span><input type="checkbox" name="Availability" value="true" checked /></label>
            <button class="btn-blue" type="submit">Create Menu Item</button>
        </form>
        <div style="margin-top:24px;">
            @foreach (var item in Model.MenuItems)
            {
                <div class="portal-card" style="margin-top:12px;">
                    <form asp-controller="Menu" asp-action="UpdateForm" method="post">
                        <input type="hidden" name="id" value="@item.MenuItemID" />
                        <div class="field-row">
                            <div class="field"><label>Item Name</label><input name="ItemName" value="@item.ItemName" required /></div>
                            <div class="field"><label>Category</label><input name="Category" value="@item.Category" required /></div>
                        </div>
                        <div class="field-row">
                            <div class="field"><label>Price</label><input name="Price" type="number" step="0.01" min="0" value="@item.Price" required /></div>
                            <div class="field"><label>Image URL</label><input name="ImageUrl" value="@item.ImageUrl" /></div>
                        </div>
                        <div class="field"><label>Description</label><textarea name="Description">@item.Description</textarea></div>
                        <label class="addon" style="margin-bottom:14px;"><span><strong>Available</strong><small>Show the item as in stock.</small></span><input type="checkbox" name="Availability" value="true" @(item.Availability ? "checked" : "") /></label>
                        <button class="btn-blue" type="submit">Save Changes</button>
                    </form>
                    <form asp-controller="Menu" asp-action="DeleteForm" method="post" style="margin-top:10px;"><input type="hidden" name="id" value="@item.MenuItemID" /><button class="stock-btn out" type="submit">Delete</button></form>
                </div>
            }
        </div>
    </div>
</div>
