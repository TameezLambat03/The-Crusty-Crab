@{
    ViewData["Title"] = "Overview";
}
<div class="topbar">
    <div class="topbar-inner wide">
        <a asp-controller="Home" asp-action="Index" class="brand">
            <span class="brand-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="2.2"/><path d="M12 7.2V21M8 11h8M4.5 14c0 3.6 3.3 7 7.5 7s7.5-3.4 7.5-7"/></svg>
            </span>
            <span>
                <span class="brand-name" style="display:block">The Crusty Crab</span>
                <span class="brand-sub" style="display:block">Montgomery Park &bull; Randburg</span>
            </span>
        </a>
        <nav class="pill-nav">
            <a asp-controller="Home" asp-action="Index" class="active">Overview</a>
            <a asp-controller="Menu" asp-action="Index">Menu</a>
            <a asp-controller="Menu" asp-action="Customise" asp-route-id="1">Customise</a>
            <a asp-controller="Checkout" asp-action="Index">Checkout</a>
            <a asp-controller="Kitchen" asp-action="Kds">Live Tracker</a>
            <a asp-controller="Kitchen" asp-action="Kds">Kitchen KDS</a>
            <a asp-controller="Manager" asp-action="Portal">Admin Portal</a>
            <a asp-controller="Menu" asp-action="Review">Feedback</a>
        </nav>
        <a asp-controller="Menu" asp-action="Index" class="btn-blue">Order Now</a>
    </div>
</div>
<section class="hero">
    <div>
        <span class="hero-chip">Product-Ready Digital Architecture Suite</span>
        <h1>Authentic Cajun Seafood Boils,<br /><span class="grad">Engineered for Excellence.</span></h1>
        <p>Explore the complete production-grade digital ordering ecosystem for The Crusty Crab in Montgomery Park, Randburg. Fully responsive across customer discovery, customisation, kitchen KDS, and management dashboards.</p>
        <div class="hero-actions">
            <a asp-controller="Menu" asp-action="Index" class="btn-blue btn-launch">Launch Customer App &rarr;</a>
            <a asp-controller="Kitchen" asp-action="Kds" class="btn-ghost">Open Kitchen KDS &#9635;</a>
        </div>
    </div>
    <div class="hub">
        <div class="hub-head">
            <span class="eyebrow">System Navigation Hub</span>
            <span class="hub-tag mono">v2.6 Ready</span>
        </div>
        <div class="hub-grid">
            <a asp-controller="Menu" asp-action="Index" class="hub-item">1. Menu Catalog <span>&rsaquo;</span></a>
            <a asp-controller="Menu" asp-action="Customise" asp-route-id="1" class="hub-item">2. Customiser <span>&rsaquo;</span></a>
            <a asp-controller="Checkout" asp-action="Index" class="hub-item">3. Checkout &amp; Pay <span>&rsaquo;</span></a>
            <a asp-controller="Kitchen" asp-action="Kds" class="hub-item">4. Live Tracker <span>&rsaquo;</span></a>
            <a asp-controller="Kitchen" asp-action="Kds" class="hub-item">5. Kitchen KDS <span>&rsaquo;</span></a>
            <a asp-controller="Manager" asp-action="Portal" class="hub-item">6. Admin Portal <span>&rsaquo;</span></a>
        </div>
    </div>
</section>
