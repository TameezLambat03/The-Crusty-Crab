@model CrustyCrab.Models.LoginRequest
@{
    ViewData["Title"] = "Sign In";
    var returnUrl = ViewData["ReturnUrl"]?.ToString();
}
<div class="topbar">
    <div class="topbar-inner wide">
        <partial name="_Brand" />
        <a asp-controller="Menu" asp-action="Index" class="btn-blue">Browse Menu</a>
    </div>
</div>
<div class="narrow stack-top">
    <div class="card-panel" style="max-width:520px;margin:0 auto;">
        <span class="eyebrow">Customer &amp; Staff Access</span>
        <h2>Sign In</h2>
        @if (TempData["Error"] is string error)
        {
            <div class="api-error">@error</div>
        }
        <form asp-action="Login" method="post">
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <div class="field">
                <label>Email or Username</label>
                <input asp-for="Identifier" required />
            </div>
            <div class="field">
                <label>Password</label>
                <input asp-for="Password" type="password" required />
            </div>
            <label class="addon" style="margin-bottom:18px;">
                <span><strong>Admin / Staff login</strong><small>Use this for the management portal.</small></span>
                <input type="checkbox" name="admin" value="true" />
            </label>
            <button type="submit" class="btn-blue btn-block">Sign In</button>
        </form>
        <div style="margin-top:18px;text-align:center;">
            <span class="muted">New customer?</span>
            <a asp-controller="Customer" asp-action="Register">Create an account</a>
        </div>
    </div>
</div>
