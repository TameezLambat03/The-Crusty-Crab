<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D14">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavWrapper">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <ImageView
                android:id="@+id/ivMenuLogo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/app_logo"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/tvMenuBrandTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THE CRUSTY CRAB"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@+id/ivMenuLogo"
                app:layout_constraintStart_toEndOf="@+id/ivMenuLogo"
                android:layout_marginStart="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/location"
                android:textColor="#3B5EFE"
                android:textSize="10sp"
                android:letterSpacing="0.1"
                app:layout_constraintTop_toBottomOf="@+id/tvMenuBrandTitle"
                app:layout_constraintStart_toStartOf="@+id/tvMenuBrandTitle" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCart"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_primary"
                android:text="@string/cart_label"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:paddingHorizontal="16dp"
                app:layout_constraintTop_toTopOf="@+id/ivMenuLogo"
                app:layout_constraintBottom_toBottomOf="@+id/ivMenuLogo"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/tvCategoryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="US-01 CATEGORY FILTERING"
                android:textColor="#3BA4FE"
                android:textSize="10sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@+id/ivMenuLogo"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="32dp"/>

            <TextView
                android:id="@+id/tvMenuHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_header"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@+id/tvCategoryLabel"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tvMenuSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_subtitle"
                android:textColor="#8A8F9E"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@+id/tvMenuHeader"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="8dp"/>

            <LinearLayout
                android:id="@+id/llFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/tvMenuSub"
                android:layout_marginTop="24dp">

                <TextView
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_selected"
                    android:text="@string/category_all"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/chipBoilBags"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="@string/category_boil_bags"
                    android:textColor="#8A8F9E"
                    android:textSize="12sp"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/chipStarters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="@string/category_starters"
                    android:textColor="#8A8F9E"
                    android:textSize="12sp"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/menuContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@+id/llFilters"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNavWrapper"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:background="#0F131D"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_home"
            android:textColor="#8A8F9E"
            android:textSize="10sp"
            android:textAlignment="center"
            android:drawableTop="@drawable/ic_home"
            android:drawableTint="#8A8F9E"
            android:drawablePadding="4dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_menu"
            android:textColor="#3B5EFE"
            android:textSize="10sp"
            android:textAlignment="center"
            android:drawableTop="@drawable/ic_menu"
            android:drawableTint="#3B5EFE"
            android:drawablePadding="4dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_cart"
            android:textColor="#8A8F9E"
            android:textSize="10sp"
            android:textAlignment="center"
            android:drawableTop="@drawable/ic_cart"
            android:drawableTint="#8A8F9E"
            android:drawablePadding="4dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_tracker"
            android:textColor="#8A8F9E"
            android:textSize="10sp"
            android:textAlignment="center"
            android:drawableTop="@drawable/ic_tracker"
            android:drawableTint="#8A8F9E"
            android:drawablePadding="4dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_account"
            android:textColor="#8A8F9E"
            android:textSize="10sp"
            android:textAlignment="center"
            android:drawableTop="@drawable/ic_account"
            android:drawableTint="#8A8F9E"
            android:drawablePadding="4dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>